#!/usr/bin/env python3
import sys

from {{agent_module}} import {{agent_class}}


def _render_result(value: object) -> str:
    if value is None:
        return ""
    return str(value)


def main() -> int:
    user_input = sys.argv[1] if len(sys.argv) > 1 else ""

    # Keep wrapper minimal and resilient to varied class-only agent signatures.
    agent = {{agent_class}}()
    if hasattr(agent, "run"):
        result = agent.run(user_input)
    elif hasattr(agent, "invoke"):
        result = agent.invoke(user_input)
    else:
        raise RuntimeError("Detected class-only LangChain agent has no run()/invoke() method")

    print(_render_result(result))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
