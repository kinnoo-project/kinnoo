{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:dev": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --config wrangler.jsonc",
    "deploy:prod": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --config wrangler.prod.jsonc",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --environment jsdom",
    "test:agent-card-modal": "vitest run --environment jsdom __tests__/agent-card-modal.test.tsx",
    "test:login": "vitest run --environment jsdom login-page.test.tsx",
    "test:landing": "vitest run __tests__/landing-page.test.tsx --environment jsdom",
    "test:registry": "vitest run --environment jsdom registry-dashboard.test.tsx"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-slot": "^1.2.4",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.6.0",
    "next": "^16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.0.0-beta",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.27.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.1",
    "wrangler": "^4.0.0"
  }
}
